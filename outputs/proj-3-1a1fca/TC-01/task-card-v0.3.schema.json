{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://half.dev/schemas/task-card-v0.3.json",
  "title": "HALF Task Card v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "background",
    "goal",
    "initial_state",
    "expected_behavior",
    "acceptance_criteria",
    "relevant_files",
    "constraints",
    "test_method",
    "difficulty",
    "context_policy",
    "suitable_experiments"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.3"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "feature",
        "bugfix",
        "refactor",
        "infra",
        "test",
        "docs",
        "research"
      ]
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "initial_state": {
      "type": "string",
      "minLength": 1
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "commands_or_steps"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "automated",
            "manual",
            "mixed"
          ]
        },
        "commands_or_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pass_signal": {
          "type": "string"
        }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_assumptions",
        "must_confirm"
      ],
      "properties": {
        "allow_assumptions": {
          "type": "boolean"
        },
        "must_confirm": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "suitable_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "workflow_comparison",
          "handoff_comparison",
          "prompt_stability",
          "execution_replay",
          "quality_review"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "plan_id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "task_code": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
